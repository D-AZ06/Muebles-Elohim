@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Muebles_Elohim.Components
@using Muebles_Elohim.Components.Shared

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>

        <header id="mainHeader">

            <div id="logoGrandeContainer">

                <img class="logo-grande"
                     src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_completo.png"
                     alt="Muebles Elohim" />

            </div>

        </header>

        <div class="top-row">

            <div id="logoSticky">

                <img class="logo-mini"
                     src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_solo_emblema.png"
                     alt="Logo" />

                <span>Muebles Elohim</span>

            </div>

            <nav class="d-flex gap-3 align-items-center">

                <NavLink class="text-decoration-none text-secondary px-2"
                    href="/">
                    Inicio
                </NavLink>

                <NavLink class="text-decoration-none text-secondary px-2"
                         href="productos">
                    Productos
                </NavLink>

                <ContadorCotizacion />

                <NavLink class="btn btn-primary px-3 text-white"
                         href="contacto">
                    Contáctanos
                </NavLink>

            </nav>

        </div>

        <article class="content px-4 py-3">
            @Body
        </article>

    </main>
</div>

<footer class="footer bg-dark text-white py-4 mt-auto">
    <div class="container text-center">
        <p class="mb-0">&copy; 2026 Muebles Elohim. Todos los derechos reservados. </p>
        <NavLink class="text-decoration-none text-secondary px-2"
                 href="privacidad">
            Privacidad
        </NavLink>
	</div>
</footer>


@code {
    private bool scrollPendiente = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += AlCambiarPagina;
    }

    private async void AlCambiarPagina(
        object? sender,
        LocationChangedEventArgs e)
    {
        await InvokeAsync(() =>
        {
            scrollPendiente = true;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollPendiente)
        {
            scrollPendiente = false;

            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarPagina;
    }
}


<script>
        window.addEventListener('scroll', () => {

        const header = document.getElementById('mainHeader');

        if (!header)
            return;

        const rect = header.getBoundingClientRect();

        if (rect.bottom <= 70) {

            document.body.classList.add('scrolled');

        } else {

            document.body.classList.remove('scrolled');

        }

    });
</script>

<script>
    window.scrollToTop = () => {
        window.scrollTo(0, 0);
    };
</script>