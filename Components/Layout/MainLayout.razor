@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Muebles_Elohim.Components
@using Muebles_Elohim.Components.Shared

<div class="page">

    <main>

        <header id="mainHeader">

            <div id="logoGrandeContainer">

                <img class="logo-grande"
                     src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_completo.png"
                     alt="Muebles Elohim" />

            </div>

        </header>

        <div class="top-row">

            <div id="logoSticky">

                <img class="logo-mini"
                     src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_solo_emblema.png"
                     alt="Logo" />

                <span>Muebles Elohim</span>

            </div>

            <nav class="d-flex gap-3 align-items-center">

                <NavLink class="text-decoration-none text-secondary px-2"
                        href="/" Match="NavLinkMatch.All"
                        aria-label="Inicio" title="Inicio">
                    <i class="bi bi-house"></i> <span class="nav-texto">Inicio</span>
                </NavLink>

                <NavLink class="text-decoration-none text-secondary px-2"
                        href="productos"
                        aria-label="Productos" title="Productos">
                    <i class="bi bi-grid"></i> <span class="nav-texto">Productos</span>
                </NavLink>

                <ContadorFavoritos />

                <NavLink class="btn btn-primary px-3 text-white"
                        href="contacto">
                    <i class="bi bi-chat-dots"></i> Contáctanos
                </NavLink>

            </nav>

        </div>

        <article class="content px-4 py-3">
            @Body
            <BotonesFlotantes />
        </article>

    </main>
</div>

<footer class="footer bg-dark text-white py-4 mt-auto">
    <div class="container text-center">
        <p class="mb-0">&copy; 2026 Muebles Elohim. Todos los derechos reservados. </p>
        <NavLink class="text-decoration-none text-secondary px-2"
                href="privacidad">
            <i class="bi bi-shield-lock"></i> Privacidad
        </NavLink>
	</div>
</footer>

@code {
    private bool scrollPendiente = false;
    private string rutaAnterior = "";

    protected override void OnInitialized()
    {
        rutaAnterior = RutaSinQuery(Navigation.Uri);
        Navigation.LocationChanged += AlCambiarPagina;
    }

    private async void AlCambiarPagina(
        object? sender,
        LocationChangedEventArgs e)
    {
        string rutaNueva = RutaSinQuery(e.Location);

        // Si solo cambió ?id=, es el modal: no se sube al inicio
        if (rutaNueva == rutaAnterior)
        {
            return;
        }

        rutaAnterior = rutaNueva;

        await InvokeAsync(() =>
        {
            scrollPendiente = true;
            StateHasChanged();
        });
    }

    private string RutaSinQuery(string uri)
    {
        string ruta = Navigation.ToBaseRelativePath(uri);
        int corte = ruta.IndexOfAny(new[] { '?', '#' });

        if (corte >= 0)
        {
            return ruta.Substring(0, corte);
        }

        return ruta;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollPendiente)
        {
            scrollPendiente = false;

            await JS.InvokeVoidAsync("colapsarHeader");
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarPagina;
    }


}