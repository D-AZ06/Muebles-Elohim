@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Muebles_Elohim.Components
@using Muebles_Elohim.Components.Shared

<div class="page">

    <main>

        <header id="mainHeader">

            <div id="logoGrandeContainer">

                <img class="logo-grande"
                     src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_completo.png"
                     alt="Muebles Elohim" />

            </div>

        </header>

        <div class="top-row">

            <a id="logoSticky" href="/" aria-label="Inicio">
                <img class="logo-mini"
                    src="https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Logo/logo_MC_solo_emblema.png"
                    alt="" />
                <span>Muebles Elohim</span>
            </a>

            <nav class="nav-centro">
                <NavLink href="/" Match="NavLinkMatch.All" aria-label="Inicio" title="Inicio">
                    <i class="bi bi-house"></i> <span class="nav-texto">Inicio</span>
                </NavLink>
                <NavLink href="productos" aria-label="Productos" title="Productos">
                    <i class="bi bi-grid"></i> <span class="nav-texto">Productos</span>
                </NavLink>
                <NavLink href="materiales" aria-label="Materiales" title="Materiales">
                    <i class="bi bi-layers"></i> <span class="nav-texto">Materiales</span>
                </NavLink>
                <NavLink href="privacidad" aria-label="Privacidad" title="Privacidad">
                    <i class="bi bi-shield-lock"></i> <span class="nav-texto">Privacidad</span>
                </NavLink>
            </nav>

            <nav class="nav-derecha">
                <ContadorFavoritos />
                <NavLink class="btn btn-primary" href="contacto" aria-label="Contáctanos" title="Contáctanos">
                    <i class="bi bi-chat-dots"></i> <span class="nav-texto">Contáctanos</span>
                </NavLink>
            </nav>

        </div>

        <article class="content px-4 py-3">
            <div class="cuerpo-pagina @claseEntrada">
                @Body
            </div>
            <BotonesFlotantes />
        </article>

    </main>
</div>

<footer class="footer bg-dark text-white py-4 mt-auto">
    <div class="container text-center">
        <p class="mb-0">&copy; 2026 Muebles Elohim. Todos los derechos reservados. </p>
        <NavLink class="text-decoration-none text-secondary px-2"
                href="privacidad">
            <i class="bi bi-shield-lock"></i> Privacidad
        </NavLink>
	</div>
</footer>

@code {
    private bool scrollPendiente = false;
    private string rutaAnterior = "";
    private string claseEntrada = "";
    private int cambiosDePagina = 0;

    protected override void OnInitialized()
    {
        rutaAnterior = RutaSinQuery(Navigation.Uri);
        Navigation.LocationChanged += AlCambiarPagina;
    }

    private async void AlCambiarPagina(
        object? sender,
        LocationChangedEventArgs e)
    {
        string rutaNueva = RutaSinQuery(e.Location);

        // Si solo cambió ?id=, es el modal: no se sube al inicio
        if (rutaNueva == rutaAnterior)
        {
            return;
        }

        rutaAnterior = rutaNueva;

        await InvokeAsync(() =>
        {
            scrollPendiente = true;

            // Alternar el nombre de la clase hace que la animación se repita en cada cambio de página
            cambiosDePagina++;
            claseEntrada = cambiosDePagina % 2 == 0 ? "entrada-a" : "entrada-b";

            StateHasChanged();
        });
    }

    private string RutaSinQuery(string uri)
    {
        string ruta = Navigation.ToBaseRelativePath(uri);
        int corte = ruta.IndexOfAny(new[] { '?', '#' });

        if (corte >= 0)
        {
            return ruta.Substring(0, corte);
        }

        return ruta;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // La app ya está conectada: desde aquí lo nuevo sí se anima
        if (firstRender)
        {
            Animacion.Activo = true;
        }

        if (scrollPendiente)
        {
            scrollPendiente = false;

            await JS.InvokeVoidAsync("colapsarHeader");
        }
    }

    // Las animaciones son solo decorativas: si algo falla, la app sigue igual
    private async Task AnimarAsync(string funcion)
    {
        try
        {
            await JS.InvokeVoidAsync(funcion);
        }
        catch (Exception)
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarPagina;
    }


}