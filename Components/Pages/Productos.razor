@page "/productos"
@rendermode InteractiveServer
@using Muebles_Elohim.Components.Shared
@using Muebles_Elohim.Components

<PageTitle>Productos - Muebles Elohim</PageTitle>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- CLASE CONDICIONAL "bloqueado" para evitar scroll y clics en el fondo -->
<div class="container my-4 catalogo @(panelAbierto ? "bloqueado" : "")">

    <!-- FILTRO PARA MÓVILES: chips con scroll horizontal -->
    <div class="filtro-movil d-lg-none">
        <div class="chips">
            @foreach (var categoria in categorias)
            {
                <button type="button"
                        class="chip @(categoriaSeleccionada == categoria.Clave ? "activo" : "")"
                        @onclick="() => SeleccionarCategoria(categoria.Clave)">
                    <i class="bi @categoria.Icono me-1"></i>@categoria.Nombre
                </button>
            }
        </div>
    </div>

    <!-- ESTRUCTURA PRINCIPAL -->
    <div class="row">

        <!-- BARRA LATERAL PARA ESCRITORIO -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white barra-lateral">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="bi bi-sliders me-2 text-primary"></i>
                        Filtros
                    </h5>
                </div>

                <div class="list-group list-group-flush gap-1">
                    @foreach (var categoria in categorias)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action border-0 rounded-2 py-2 px-3 d-flex align-items-center gap-2 @(categoriaSeleccionada == categoria.Clave ? "active" : "")"
                                @onclick="() => SeleccionarCategoria(categoria.Clave)">
                            <i class="bi @categoria.Icono"></i>
                            <span class="flex-grow-1">@categoria.Nombre</span>
                            <span class="filtro-cantidad">@ContarPorCategoria(categoria.Clave)</span>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <!-- CATÁLOGO DE PRODUCTOS -->
        <main class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark m-0">Nuestros Productos</h2>
                @if (!cargando)
                {
                    <span class="text-muted small">@ProductosFiltrados.Count productos</span>
                }
            </div>

            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted mt-3">Cargando productos...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    @mensajeError
                    <button class="btn btn-outline-danger btn-sm ms-2" @onclick="CargarProductos">
                        Reintentar
                    </button>
                </div>
            }
            else if (ProductosFiltrados.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-3 text-muted"></i>
                    <h5 class="mt-3">No hay productos disponibles</h5>
                    <p class="text-muted">No encontramos productos en esta categoría.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var producto in ProductosFiltrados)
                    {
                        <div class="col-12 col-sm-6 col-xl-4" @key="producto.Id">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                <img src="@producto.Foto"
                                     alt="@producto.Titulo"
                                     class="card-img-top"
                                     loading="lazy"
                                     style="height: 230px; object-fit: cover;" />

                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-light text-primary border align-self-start mb-2">
                                        @producto.Categoria
                                    </span>

                                    <h5 class="card-title fw-bold">@producto.Titulo</h5>

                                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                                    {
                                        <p class="card-text text-muted small descripcion-corta">
                                            @producto.Descripcion
                                        </p>
                                    }

                                    <div class="mt-auto pt-3">
                                        <button type="button"
                                                class="btn btn-dark w-100 rounded-3"
                                                @onclick="() => AbrirDetalle(producto)">
                                            <i class="bi bi-eye me-2"></i>
                                            Ver más información
                                        </button>

                                        <BotonAgregarCotizacion ProductoId="@producto.Id.ToString()"
                                                                Nombre="@producto.Titulo"
                                                                Imagen="@producto.Foto" />

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<!-- VENTANA EMERGENTE (MODAL) DE DETALLE -->
<div class="detalle-fondo @(panelAbierto ? "visible" : "")" @onclick="CerrarDetalle"></div>

<div class="detalle-modal-contenedor @(panelAbierto ? "abierto" : "")"
     role="dialog" aria-modal="true" aria-label="Información del producto">
    @if (productoSeleccionado is not null)
    {
        <div class="detalle-modal-grid">

            <!-- MITAD IZQUIERDA: Foto vertical tocando arriba/abajo exacto y blur solo a los costados -->
            <div class="detalle-foto-container">
                <div class="foto-blur-bg" style="background-image: url('@productoSeleccionado.Foto');"></div>
                <img src="@productoSeleccionado.Foto"
                     alt="@productoSeleccionado.Titulo"
                     class="foto-principal" />
            </div>

            <!-- MITAD DERECHA: Información -->
            <div class="detalle-info-container">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <span class="badge bg-light text-primary border">
                        @productoSeleccionado.Categoria
                    </span>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarDetalle"></button>
                </div>

                <h3 class="fw-bold text-dark h4 mb-3">@productoSeleccionado.Titulo</h3>

                <div class="detalle-texto-scroll flex-grow-1 mb-4">
                    @if (!string.IsNullOrWhiteSpace(productoSeleccionado.Descripcion))
                    {
                        <p class="text-muted detalle-texto m-0">@productoSeleccionado.Descripcion</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic m-0">Sin descripción disponible.</p>
                    }
                </div>

                <div class="mt-auto pt-3 border-top">

                    <BotonAgregarCotizacion ProductoId="@productoSeleccionado.Id.ToString()"
                                            Nombre="@productoSeleccionado.Titulo"
                                            Imagen="@productoSeleccionado.Foto" />

                    <button type="button" class="btn btn-dark w-100 rounded-3 py-2" @onclick="CerrarDetalle">
                        Cerrar
                    </button>
                </div>
            </div>

        </div>
    }
</div>

@if (panelAbierto)
{
    <style>
        html, body {
            overflow: hidden !important;
        }
    </style>
}