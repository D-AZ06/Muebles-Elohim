@page "/productos"
@using Muebles_Elohim.Components.Shared
@using Muebles_Elohim.Components

<PageTitle>Productos - Muebles Elohim</PageTitle>

@if (panelAbierto && productoSeleccionado is not null)
{
    <HeadContent>
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@productoSeleccionado.Titulo - Muebles Elohim" />
        <meta property="og:description" content="@productoSeleccionado.Descripcion" />
        <meta property="og:image" content="@productoSeleccionado.Foto" />
    </HeadContent>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- CLASE CONDICIONAL "bloqueado" para evitar scroll y clics en el fondo -->
<div class="container my-4 catalogo @(panelAbierto ? "bloqueado" : "")">

    <!-- FILTRO PARA MÓVILES: chips con scroll horizontal -->
    <div class="filtro-movil d-lg-none">
        <div class="chips">
            @foreach (var categoria in categorias)
            {
                <button type="button"
                        class="chip @(categoriaSeleccionada == categoria.Clave ? "activo" : "")"
                        @onclick="() => SeleccionarCategoria(categoria.Clave)">
                    <i class="bi @categoria.Icono me-1"></i>@categoria.Nombre
                </button>
            }
        </div>
    </div>

    <!-- ESTRUCTURA PRINCIPAL -->
    <div class="row">

        <!-- BARRA LATERAL PARA ESCRITORIO -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white barra-lateral">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="bi bi-sliders me-2 text-primary"></i>
                        Filtros
                    </h5>
                </div>

                <div class="list-group list-group-flush gap-1">
                    @foreach (var categoria in categorias)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action border-0 rounded-2 py-2 px-3 d-flex align-items-center gap-2 @(categoriaSeleccionada == categoria.Clave ? "active" : "")"
                                @onclick="() => SeleccionarCategoria(categoria.Clave)">
                            <i class="bi @categoria.Icono"></i>
                            <span class="flex-grow-1">@categoria.Nombre</span>
                            <span class="filtro-cantidad">@ContarPorCategoria(categoria.Clave)</span>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <!-- CATÁLOGO DE PRODUCTOS -->
        <main class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark m-0">Nuestros Productos</h2>
                @if (!cargando)
                {
                    <span class="text-muted small">@ProductosFiltrados.Count productos</span>
                }
            </div>

            @if (productoNoDisponible)
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
                    <span>Ese producto ya no está disponible. Mira el resto de nuestro catálogo.</span>
                    <a href="/productos" class="btn btn-sm btn-outline-dark text-nowrap">Ver catálogo</a>
                </div>
            }

            @if (cargando)
            {
                <div class="row g-4" role="status" aria-busy="true">
                    <span class="visually-hidden">Cargando productos...</span>

                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="col-12 col-sm-6 col-xl-4 d-flex" aria-hidden="true">
                            <div class="skeleton-tarjeta">
                                <div class="skeleton skeleton-foto"></div>
                                <div class="skeleton-cuerpo">
                                    <div class="skeleton skeleton-linea" style="width:70%"></div>
                                    <div class="skeleton skeleton-linea"></div>
                                    <div class="skeleton skeleton-linea" style="width:55%"></div>
                                    <div class="skeleton skeleton-boton"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    @mensajeError
                    <button class="btn btn-outline-danger btn-sm ms-2" @onclick="CargarProductos">
                        Reintentar
                    </button>
                </div>
            }
            else if (ProductosFiltrados.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-3 text-muted"></i>
                    <h5 class="mt-3">No hay productos disponibles</h5>
                    <p class="text-muted">No encontramos productos en esta categoría.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var producto in ProductosPagina)
                    {
                        <div class="col-12 col-sm-6 col-xl-4 d-flex @(animar ? "entra" : "")" @key="(categoriaSeleccionada, producto.Id)">
                            <article class="tarjeta-producto">

                                <div class="tarjeta-media">
                                    <div class="tarjeta-foto"
                                        role="button"
                                        tabindex="0"
                                        title="Ver imagen completa"
                                        data-foto="@producto.Foto"
                                        data-titulo="@producto.Titulo"
                                        onclick="visorImagen.abrir(this.dataset.foto, this.dataset.titulo)">
                                        <img src="@producto.Foto" alt="@producto.Titulo" loading="lazy" />

                                        <span class="tarjeta-categoria">
                                            <i class="bi @IconoDe(producto.Categoria)"></i>
                                            @producto.Categoria
                                        </span>

                                        <div class="tarjeta-velo">
                                            <span><i class="bi bi-arrows-fullscreen"></i> Ver foto completa</span>
                                        </div>
                                    </div>

                                    <div class="favorito-esquina">
                                        <BotonFavorito ProductoId="@producto.Id.ToString()"
                                                    Categoria="@producto.Categoria"
                                                    Nombre="@producto.Titulo"
                                                    Imagen="@producto.Foto" />
                                    </div>
                                </div>

                                <div class="tarjeta-cuerpo">
                                    <h5 class="tarjeta-titulo">@producto.Titulo</h5>

                                    <p class="tarjeta-desc descripcion-corta">@producto.Descripcion</p>

                                    <div class="tarjeta-pie">
                                        <div class="tarjeta-detalles">
                                            <span><i class="bi bi-rulers"></i>A medida</span>
                                            <span><i class="bi bi-shield-check"></i>Garantizado</span>
                                        </div>

                                        <div class="tarjeta-acciones">
                                            <button type="button" class="btn-detalle" @onclick="() => AbrirDetalle(producto)">
                                                <i class="bi bi-eye"></i>
                                                Ver más información
                                            </button>

                                            <BotonAgregarCotizacion ProductoId="@producto.Id.ToString()"
                                                                    Nombre="@producto.Titulo"
                                                                    Imagen="@producto.Foto" />
                                        </div>
                                    </div>
                                </div>

                            </article>
                        </div>
                    }
                </div>

                @if (TotalPaginas > 0)
                {
                    <nav class="d-flex justify-content-center align-items-center gap-2 gap-sm-3 mt-5 mb-5" aria-label="Paginación de productos">
                        <button type="button" class="btn btn-outline-dark rounded-pill px-3"
                                aria-label="Página anterior"
                                disabled="@(paginaActual == 1)"
                                @onclick="() => IrAPagina(paginaActual - 1)">
                            <i class="bi bi-chevron-left"></i><span class="d-none d-sm-inline ms-1">Anterior</span>
                        </button>

                        <span class="text-muted">Página <strong class="text-dark">@paginaActual</strong> de @TotalPaginas</span>

                        <button type="button" class="btn btn-outline-dark rounded-pill px-3"
                                aria-label="Página siguiente"
                                disabled="@(paginaActual == TotalPaginas)"
                                @onclick="() => IrAPagina(paginaActual + 1)">
                            <span class="d-none d-sm-inline me-1">Siguiente</span><i class="bi bi-chevron-right"></i>
                        </button>
                    </nav>
                }

            }
        </main>
    </div>
</div>

<!-- VENTANA EMERGENTE (MODAL) DE DETALLE -->
<div class="detalle-fondo @(panelAbierto ? "visible" : "")" @onclick="CerrarDetalle"></div>

<div class="detalle-modal-contenedor @(panelAbierto ? "abierto" : "")"
     @ref="modalRef" tabindex="-1" style="outline:none" @onkeydown="TeclaModal"
     role="dialog" aria-modal="true" aria-label="Información del producto">
    @if (productoSeleccionado is not null)
    {
        <div class="detalle-modal-grid">

            <!-- MITAD IZQUIERDA: Foto vertical tocando arriba/abajo exacto y blur solo a los costados -->
            <div class="detalle-foto-container">
                <div class="foto-blur-bg" style="background-image: url('@productoSeleccionado.Foto');"></div>
                <img src="@productoSeleccionado.Foto"
                     alt="@productoSeleccionado.Titulo"
                     class="foto-principal" />

                <div class="favorito-modal">
                    <BotonFavorito ProductoId="@productoSeleccionado.Id.ToString()"
                                Categoria="@productoSeleccionado.Categoria"
                                Nombre="@productoSeleccionado.Titulo"
                                Imagen="@productoSeleccionado.Foto" />
                </div>

                <button type="button"
                        class="btn-ver-foto"
                        aria-label="Ver imagen completa"
                        title="Ver imagen completa"
                        data-foto="@productoSeleccionado.Foto"
                        data-titulo="@productoSeleccionado.Titulo"
                        onclick="visorImagen.abrir(this.dataset.foto, this.dataset.titulo)">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
            </div>

            <!-- MITAD DERECHA: Información -->
            <div class="detalle-info-container">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <span class="badge bg-light text-primary border">
                        @productoSeleccionado.Categoria
                    </span>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarDetalle"></button>
                </div>

                <h3 class="fw-bold text-dark h4 mb-3">@productoSeleccionado.Titulo</h3>

                <div class="detalle-texto-scroll flex-grow-1 mb-4">
                    @if (!string.IsNullOrWhiteSpace(productoSeleccionado.Descripcion))
                    {
                        <p class="text-muted detalle-texto m-0">@productoSeleccionado.Descripcion</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic m-0">Sin descripción disponible.</p>
                    }
                </div>

                <div class="mt-auto pt-3 border-top detalle-acciones" @onclick:stopPropagation="true">

                  <div class="compartir-wrapper"
                       @onmouseenter="AbrirMenuCompartir"
                       @onmouseleave="CerrarMenuCompartir">
                      <button type="button"
                              class="btn btn-outline-secondary rounded-3 btn-accion-icono @(menuCompartirAbierto ? "active" : "")"
                              aria-label="Compartir producto"
                              aria-expanded="@menuCompartirAbierto"
                              title="Compartir"
                              @onclick="AlternarMenuCompartir">
                          <i class="bi @(enlaceCopiado ? "bi-check2 text-success" : "bi-share")"></i>
                      </button>

                      @if (menuCompartirAbierto)
                      {
                          <div class="compartir-menu shadow-lg rounded-3 border bg-white py-1" role="menu">
                              <button type="button"
                                      class="compartir-item"
                                      role="menuitem"
                                      @onclick="CotizarPorWhatsApp">
                                  <i class="bi bi-whatsapp text-success"></i>
                                  <div class="text-start">
                                      <div class="fw-semibold small text-dark">Cotizar por WhatsApp</div>
                                      <div class="text-muted" style="font-size: .72rem;">Enviar con info del mueble</div>
                                  </div>
                              </button>

                              <button type="button"
                                      class="compartir-item"
                                      role="menuitem"
                                      @onclick="CopiarEnlace">
                                  <i class="bi @(enlaceCopiado ? "bi-check2 text-success" : "bi-link-45deg")"></i>
                                  <div class="text-start">
                                      <div class="fw-semibold small text-dark">
                                          @(enlaceCopiado ? "¡Enlace copiado!" : "Copiar enlace")
                                      </div>
                                      <div class="text-muted" style="font-size: .72rem;">Copiar URL directa</div>
                                  </div>
                              </button>

                              <div class="dropdown-divider my-1"></div>

                              <button type="button"
                                      class="compartir-item"
                                      role="menuitem"
                                      @onclick="CompartirEnOtrasApps">
                                  <i class="bi bi-box-arrow-up-right text-primary"></i>
                                  <div class="text-start">
                                      <div class="fw-semibold small text-dark">Compartir en otras apps</div>
                                      <div class="text-muted" style="font-size: .72rem;">Enviar a un contacto o app</div>
                                  </div>
                              </button>
                          </div>
                      }
                  </div>

                  <div class="detalle-acciones-cotizar">
                      <BotonAgregarCotizacion ProductoId="@productoSeleccionado.Id.ToString()"
                                              Nombre="@productoSeleccionado.Titulo"
                                              Imagen="@productoSeleccionado.Foto" />
                  </div>

                  @if (enlaceCopiado)
                    {
                        <div class="mensaje-copiado">
                            <i class="bi bi-check-circle-fill"></i>
                            Enlace copiado al portapapeles
                        </div>
                    }

              </div>
            </div>

        </div>
    }
</div>

@if (panelAbierto)
{
    <style>
        html, body {
            overflow: hidden !important;
        }

        /* ===== Botones (escritorio ≥ 1024px: a los lados de la tarjeta) ===== */
        .nav-circulo {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 52px;
            height: 52px;
            padding: 0;
            border: 1px solid rgba(255, 255, 255, .35);
            border-radius: 50%;
            background: rgba(255, 255, 255, .18);
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
            color: #fff;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 20px rgba(0, 0, 0, .25);
            z-index: 1060;
            cursor: pointer;
            transition: background-color .2s ease, transform .2s ease;
        }

            .nav-circulo:hover {
                background: rgba(255, 255, 255, .32);
                transform: translateY(-50%) scale(1.08);
            }

            .nav-circulo.izq {
                left: calc(50% - 440px - 64px);
            }

            .nav-circulo.der {
                right: calc(50% - 440px - 64px);
            }

        /* ===== Menos de 1024px: botones juntos, debajo de la tarjeta ===== */
        @@media (max-width: 1023.98px) {
            .nav-circulo {
                width: 48px;
                height: 48px;
                top: auto;
                bottom: calc(24px + env(safe-area-inset-bottom, 0px));
                transform: none;
            }

                .nav-circulo:hover {
                    transform: scale(1.08);
                }

                .nav-circulo.izq {
                    left: auto;
                    right: calc(50% + 10px);
                }

                .nav-circulo.der {
                    right: auto;
                    left: calc(50% + 10px);
                }
            /* Se sube la tarjeta y se limita su altura para dejar sitio a los botones */
            .detalle-modal-contenedor {
                top: calc(50% - 36px) !important;
                max-height: calc(100dvh - 130px) !important;
            }
        }

        /* Tablet (2 columnas): altura fija de 520px, pero nunca más de lo que cabe */
        @@media (min-width: 768px) and (max-width: 1023.98px) {
            .detalle-modal-contenedor {
                height: min(520px, calc(100dvh - 130px)) !important;
            }
        }

        /* Móvil (1 columna): el texto hace scroll dentro de lo que sobra bajo la foto */
        @@media (max-width: 767.98px) {
            .detalle-info-container {
                max-height: calc(100dvh - 130px - 280px) !important;
            }
        }
    </style>

    <button type="button"
            class="nav-circulo izq"
            aria-label="Anterior"
            @onclick="() => CambiarProducto(-1)">
        <i class="bi bi-chevron-left"></i>
    </button>

    <button type="button"
            class="nav-circulo der"
            aria-label="Siguiente"
            @onclick="() => CambiarProducto(1)">
        <i class="bi bi-chevron-right"></i>
    </button>
}

