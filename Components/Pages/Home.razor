@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Inicio - Muebles Elohim</PageTitle>

<!-- Enlace CDN de Bootstrap Icons para los iconos -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="home-container container my-4">
    <!-- Encabezado / Título principal -->
    <div class="hero-section text-center mb-4">
        <h1 class="display-5 fw-bold text-dark">BIENVENIDO A MUEBLES ELOHIM</h1>
        <p class="slogan text-muted fs-5">
            Haciendo de tus espacios el lugar soñado
        </p>
    </div>

    <!-- Carrusel Interactivo -->
    <div class="carousel-container shadow-lg rounded overflow-hidden mb-5 position-relative">
        <div class="carousel-inner-custom">
            @for (int i = 0; i < slides.Length; i++)
            {
                var index = i;
                <div class="slide-item @(currentIndex == i ? "active" : "")">
                    <!-- 1. Fondo difuminado con la misma imagen -->
                    <div class="slide-bg-blur" style="background-image: url('@slides[i].ImageUrl');"></div>

                    <!-- 2. Imagen principal completa y centrada -->
                    <div class="slide-img-wrapper">
                        <img src="@slides[i].ImageUrl" alt="@slides[i].Title" />
                    </div>

                    <!-- 3. Título y descripción -->
                    <div class="slide-caption">
                        <h5>@slides[i].Title</h5>
                        <p>@slides[i].Description</p>
                    </div>
                </div>
            }
        </div>

        <!-- Indicadores tipo Puntos / Cápsulas debajo de la descripción -->
        <div class="dots-indicators-container">
            @for (int j = 0; j < slides.Length; j++)
            {
                var targetIndex = j;
                <div class="dot-item @(currentIndex == targetIndex ? "active" : "")"
                     @onclick="() => SeleccionarSlide(targetIndex)"
                     title="Ir a diapositiva @(targetIndex + 1)">
                    @if (currentIndex == targetIndex)
                    {
                        <div class="dot-progress" @key="currentIndex" style="animation-duration: @(slideInterval)ms;"></div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Sección: Quiénes Somos -->
    <section class="row my-5 align-items-center bg-white p-4 rounded shadow-sm border-start border-primary border-4">
        <div class="col-md-12">
            <h3 class="text-primary fw-bold mb-3">¿Quiénes Somos?</h3>
            <p class="text-secondary fs-6 lh-lg m-0">
                En <strong>Muebles Elohim</strong> nos apasiona transformar cada rincón de tu hogar en un espacio único, funcional y lleno de vida. Somos una empresa dedicada al diseño, fabricación y comercialización de mobiliario de alta calidad, combinando la dedicación artesanal con tendencias modernas para adaptarnos a las necesidades de cada familia.
            </p>
        </div>
    </section>

    <!-- Sección: Qué Ofrecemos -->
    <section class="row my-5 g-4">
        <div class="col-12">
            <h3 class="text-primary fw-bold mb-3 border-bottom pb-2">¿Qué Ofrecemos?</h3>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 text-center feature-card">
                <div class="card-body">
                    <i class="bi bi-house-gear text-primary mb-3" style="font-size: 2.5rem;"></i>
                    <h5 class="card-title fw-bold text-dark">Diseños a Medida</h5>
                    <p class="card-text text-muted">Creamos muebles personalizados que se ajustan perfectamente a las dimensiones y estilo de tus espacios.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 text-center feature-card">
                <div class="card-body">
                    <i class="bi bi-award text-primary mb-3" style="font-size: 2.5rem;"></i>
                    <h5 class="card-title fw-bold text-dark">Calidad Garantizada</h5>
                    <p class="card-text text-muted">Utilizamos materiales de primera selección para asegurar durabilidad, resistencia y acabados estéticos superiores.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 text-center feature-card">
                <div class="card-body">
                    <i class="bi bi-truck text-primary mb-3" style="font-size: 2.5rem;"></i>
                    <h5 class="card-title fw-bold text-dark">Asesoría y Entrega</h5>
                    <p class="card-text text-muted">Te acompañamos en todo el proceso de elección y llevamos tus muebles de forma segura hasta tu hogar.</p>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Botón flotante centrado abajo -->
<div class="floating-btn-container">
    <a href="productos" target="_blank" class="btn btn-primary shadow-lg text-white">
        <i class="bi bi-shop"></i> <span class="btn-text">Ver Productos</span>
    </a>
</div>

<style>
    .home-container {
        padding-bottom: 6rem;
    }

    /* Estilos del carrusel */
    .carousel-container {
        position: relative;
        width: 100%;
        height: 480px;
        overflow: hidden;
        background: #000;
    }

    .carousel-inner-custom {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .slide-item {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

        .slide-item.active {
            opacity: 1;
            z-index: 2;
            pointer-events: auto;
        }

    /* 1. Capa de fondo difuminado */
    .slide-bg-blur {
        position: absolute;
        top: -20px;
        left: -20px;
        right: -20px;
        bottom: -20px;
        background-size: cover;
        background-position: center;
        filter: blur(20px) brightness(0.6);
        z-index: 1;
    }

    /* 2. Contenedor de la imagen principal completa */
    .slide-img-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 85px;
    }

        .slide-img-wrapper img {
            max-width: 100%;
            max-height: calc(100% - 40px);
            object-fit: contain;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

    /* 3. Título y descripción */
    .slide-caption {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.75);
        color: #fff;
        padding: 8px 16px;
        border-radius: 10px;
        text-align: center;
        width: 85%;
        max-width: 600px;
        z-index: 5;
        backdrop-filter: blur(5px);
    }

        .slide-caption h5 {
            font-size: 0.95rem;
            margin-bottom: 2px;
            font-weight: 600;
        }

        .slide-caption p {
            font-size: 0.8rem;
            margin-bottom: 6px;
            color: #ddd;
        }

    /* Contenedor de Indicadores (Puntos / Cápsulas debajo de la descripción) */
    .dots-indicators-container {
		padding: 0px;
        position: absolute;
        bottom: 4px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        z-index: 20;
    }

    /* Estado Normal: Punto pequeño */
    .dot-item {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Estado Hover: Se expande a cápsula sin llenarse */
        .dot-item:hover {
            width: 28px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.7);
        }

        /* Estado Activo: Se expande a cápsula y se va llenando con la barra blanca */
        .dot-item.active {
            width: 32px;
            height: 8px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.3);
        }

    .dot-progress {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        background: #ffffff;
        width: 0%;
        animation-name: capsuleFill;
        animation-timing-function: linear;
        animation-fill-mode: forwards;
    }

    @@keyframes capsuleFill {
        from {
            width: 0%;
        }

        to {
            width: 100%;
        }
    }

    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    /* --- ESTILOS DEL BOTÓN FLOTANTE (Suave y Fluido) --- */
    .floating-btn-container {
        position: fixed;
        bottom: 25px;
        right: 25px;
        left: auto;
        transform: none;
        z-index: 1050;
        /* Transición suave para el desplazamiento de esquina a centro */
        transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1), left 0.7s cubic-bezier(0.25, 1, 0.5, 1), right 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    }

        .floating-btn-container .btn {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            box-shadow: 0 4px 20px rgba(13, 110, 253, 0.4);
            /* Transiciones independientes y más lentas para evitar saltos toscos */
            transition: width 0.7s cubic-bezier(0.25, 1, 0.5, 1), height 0.7s cubic-bezier(0.25, 1, 0.5, 1), padding 0.7s cubic-bezier(0.25, 1, 0.5, 1), border-radius 0.7s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease, transform 0.4s ease;
            /* Forma inicial: Bolita redonda */
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            overflow: hidden;
            white-space: nowrap;
        }

            /* Transición fluida para el texto (evita que aparezca de golpe) */
            .floating-btn-container .btn .btn-text {
                opacity: 0;
                max-width: 0;
                display: inline-block;
                overflow: hidden;
                white-space: nowrap;
                transition: opacity 0.4s ease, max-width 0.6s ease, margin 0.6s ease;
                margin-left: 0;
            }

            .floating-btn-container .btn i {
                font-size: 1.4rem;
                margin: 0;
            }

        .floating-btn-container:hover .btn {
            transform: scale(1.08);
            box-shadow: 0 6px 25px rgba(13, 110, 253, 0.6);
        }

        /* ESTADO ACTIVADO CUANDO LLEGA AL FINAL DE LA PÁGINA (.at-bottom) */
        .floating-btn-container.at-bottom {
            position: fixed;
            bottom: 30px;
            left: 50%;
            right: auto;
            transform: translateX(-50%);
        }

            .floating-btn-container.at-bottom .btn {
                width: 220px; /* Ancho final controlado para que se deslice con elegancia */
                height: 48px;
                border-radius: 50px;
                padding: 0 20px;
                box-shadow: 0 10px 30px rgba(13, 110, 253, 0.6);
            }

                /* Revelado suave del texto y margen */
                .floating-btn-container.at-bottom .btn .btn-text {
                    opacity: 1;
                    max-width: 170px;
                    margin-left: 10px;
                    font-weight: bold;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    font-size: 0.9rem;
                }

            .floating-btn-container.at-bottom:hover .btn {
                transform: scale(1.03);
            }
</style>

@code {
    private int currentIndex = 0;
    private int slideInterval = 4000; // 4 segundos por imagen
    private CancellationTokenSource? cts;

    private class SlideInfo
    {
        public string ImageUrl { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private SlideInfo[] slides = new[]
    {
        new SlideInfo { ImageUrl = "https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Carrusel/televisor.jpeg", Title = "Centros de TV y Paneles Flotantes", Description = "Diseños empotrados a la pared con acabados modernos para una sala limpia y sofisticada." },
        new SlideInfo { ImageUrl = "https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Carrusel/cocina.jpeg", Title = "Cocinas Integrales a Medida", Description = "Gabinetes y alacenas funcionales que aprovechan al máximo cada espacio de tu cocina." },
        new SlideInfo { ImageUrl = "https://dhqcnrgknozpixhplobn.supabase.co/storage/v1/object/public/Carrusel/closet.jpeg", Title = "Muebles a Medida y Closets", Description = "Clósets y muebles a medida que combinan la máxima organización con un estilo elegante." }
    };

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        _ = IniciarCicloAutomatico(cts.Token);
    }

    private async Task IniciarCicloAutomatico(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(slideInterval, token);
                if (!token.IsCancellationRequested)
                {
                    currentIndex = (currentIndex + 1) % slides.Length;
                    StateHasChanged();
                }
            }
        }
        catch (TaskCanceledException) { }
    }

    private void SeleccionarSlide(int index)
    {
        currentIndex = index;

        // Reiniciar el temporizador para que cuente 4 segundos completos desde el clic
        cts?.Cancel();
        cts = new CancellationTokenSource();
        _ = IniciarCicloAutomatico(cts.Token);

        StateHasChanged();
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Script ultraligero para mover el botón automáticamente cuando llegues al final de la página
            await JS.InvokeVoidAsync("eval", @"
            window.addEventListener('scroll', () => {
                const scrollPosition = window.innerHeight + window.scrollY;
                const threshold = document.documentElement.scrollHeight - 60;
                const container = document.querySelector('.floating-btn-container');
                if (container) {
                    if (scrollPosition >= threshold) {
                        container.classList.add('at-bottom');
                    } else {
                        container.classList.remove('at-bottom');
                    }
                }
            });
        ");
        }
    }
}