@page "/cotizacion"
@using Muebles_Elohim.Models
@using Muebles_Elohim.Components.Shared

<PageTitle>Mi cotización | Muebles Elohim</PageTitle>

@if (ultimoQuitado is not null)
{
    <p class="ayuda">
        Quitaste "@ultimoQuitado.Nombre".
        <button type="button" class="quitar" @onclick="Deshacer">Deshacer</button>
    </p>
}

@if (quitadosPorCatalogo > 0)
{
    <p class="ayuda">
        @(quitadosPorCatalogo == 1
            ? "Un producto de tu lista ya no está disponible y se quitó."
            : $"{quitadosPorCatalogo} productos de tu lista ya no están disponibles y se quitaron.")
</p>
}

<section class="cotizacion">

    @if (Lista.Items.Count == 0)
    {
        <EstadoVacio Icono="bi-card-checklist"
                     Titulo="Tu lista de cotización está vacía"
                     Mensaje="Agrega los muebles que te interesen y envía tu cotización por WhatsApp en un par de toques." />
    }
    else
    {
        <h1>Mi lista de cotización</h1>

        <ul class="lista">
            @foreach (ItemCotizacion item in Lista.Items)
            {
                <li class="fila reveal" @key="item.ProductoId">
                    <a class="fila-foto" href="@EnlaceDe(item)" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(item.Imagen))
                        {
                            <img src="@item.Imagen" alt="" loading="lazy" />
                        }
                    </a>

                    <div class="fila-texto">
                        <span class="fila-tipo">@TipoDe(item)</span>
                        <a class="fila-nombre" href="@EnlaceDe(item)">@item.Nombre</a>
                    </div>

                    <div class="fila-acciones">
                        <div class="cantidad">
                            <button type="button" aria-label="Menos" @onclick="() => CambiarCantidad(item, item.Cantidad - 1)">−</button>
                            <span>@item.Cantidad</span>
                            <button type="button" aria-label="Más" @onclick="() => CambiarCantidad(item, item.Cantidad + 1)">+</button>
                        </div>

                        <button type="button" class="quitar" aria-label="Quitar @item.Nombre" @onclick="() => Quitar(item)">
                            <i class="bi bi-trash3"></i> Quitar
                        </button>
                    </div>
                </li>
            }
        </ul>

        <button type="button" class="quitar" @onclick="Vaciar">Vaciar lista</button>

        <h2>Tus datos</h2>

        <label>
            Nombre
            <input type="text" class="campo" maxlength="100" autocomplete="name"
                   @bind="_solicitud.Nombre" @bind:event="oninput" />
        </label>

        <label>
            Teléfono
            <input type="tel" class="campo" maxlength="20" autocomplete="tel"
                   @bind="_solicitud.Telefono" @bind:event="oninput" />
        </label>

        <label>
            <input type="checkbox" @bind="_solicitud.AceptaDatos" />
            Autorizo el tratamiento de mis datos para recibir la cotización
            (<a href="/privacidad" target="_blank">política de privacidad</a>).
        </label>

        @if (!Cotizaciones.TieneNumeroConfigurado())
        {
            <div class="aviso error">
                <p>El WhatsApp del taller aún no está configurado. Intenta más tarde.</p>
            </div>
        }
        else if (DatosValidos())
        {
            string url = ObtenerUrlWhatsApp();

            @if (url.Length > 4000)
            {
                <div class="aviso error">
                    <p>Tu lista es muy larga para enviarla en un solo mensaje. Quita algunos productos o envíala en dos cotizaciones.</p>
                </div>
            }
            else
            {
                <a class="btn-whatsapp" href="@url" target="_blank" rel="noopener">
                    Enviar cotización por WhatsApp
                </a>
            }
        }
        else
        {
            <button type="button" class="btn-whatsapp" disabled>Enviar cotización por WhatsApp</button>
            <p class="ayuda">Completa nombre, teléfono y ciudad, y autoriza el tratamiento de datos.</p>
        }

        <p class="nota">
            Se abrirá WhatsApp con tu mensaje listo para enviar. No guardamos tus datos en esta página
            (<a href="/privacidad" target="_blank">política de privacidad</a>).
        </p>
    }
</section>
