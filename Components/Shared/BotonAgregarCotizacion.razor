@implements IDisposable
@inject Services.ListaCotizacionServicio Lista

@* Botón para las tarjetas. Con Icono="true" sale como círculo (se usa en Materiales) *@
@if (Icono)
{
    <button type="button"
            class="btn-cot-icono @(Lista.Contiene(ProductoId) ? "activo" : "") @(listaLlena ? "llena" : "")"
            aria-label="@Etiqueta"
            aria-pressed="@(Lista.Contiene(ProductoId) ? "true" : "false")"
            title="@Etiqueta"
            @onclick="Alternar">
        <i class="bi @(Lista.Contiene(ProductoId) ? "bi-clipboard-check-fill" : "bi-clipboard-plus")"></i>
    </button>
}
else if (Lista.Contiene(ProductoId))
{
    <a class="btn-cotizar agregado" href="/cotizacion">En tu lista (@Lista.CantidadDe(ProductoId)) · Ver</a>
}
else
{
    <button type="button" class="btn-cotizar" @onclick="Agregar">Agregar a cotización</button>

    @if (listaLlena)
    {
        <small class="text-danger d-block mt-1">
            Tu lista está llena (máximo @Services.ListaCotizacionServicio.MaxProductos productos).
            Envía esta cotización y luego arma otra.
        </small>
    }
}

@code {
    [Parameter, EditorRequired]
    public string ProductoId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Nombre { get; set; } = string.Empty;

    [Parameter]
    public string Imagen { get; set; } = string.Empty;

    [Parameter]
    public string Categoria { get; set; } = string.Empty;

    // true = botón circular con ícono, en vez del botón de texto
    [Parameter]
    public bool Icono { get; set; }

    private bool listaLlena;

    private string Etiqueta =>
        listaLlena
            ? "Tu lista está llena (máximo " + Services.ListaCotizacionServicio.MaxProductos + " productos)"
            : Lista.Contiene(ProductoId) ? "Quitar de la cotización" : "Agregar a la cotización";

    protected override void OnInitialized()
    {
        Lista.OnChange += Refrescar;
    }

    private void Refrescar()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task Agregar()
    {
        bool agregado = await Lista.AgregarAsync(ProductoId, Nombre, Imagen);
        listaLlena = !agregado;
    }

    // Versión de ícono: agrega y, si ya estaba, lo quita
    private async Task Alternar()
    {
        if (Lista.Contiene(ProductoId))
        {
            listaLlena = false;
            await Lista.QuitarAsync(ProductoId);
            return;
        }

        await Agregar();
    }

    public void Dispose()
    {
        Lista.OnChange -= Refrescar;
    }
}